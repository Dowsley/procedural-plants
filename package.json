{
  "name": "little-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
